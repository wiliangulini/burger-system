{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(rg *)",
      "Bash(cat package.json)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run test)",
      "Bash(npm run test *)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:e2e)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma migrate status)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/secrets/**)",
      "Read(./**/*secret*)",
      "Read(./**/*secrets*)",
      "Read(./**/*credential*)",
      "Read(./**/*credentials*)",
      "Read(./**/*token*)",
      "Read(./**/*cert*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./secrets/**)",
      "Edit(./**/secrets/**)",
      "Edit(./**/*secret*)",
      "Edit(./**/*secrets*)",
      "Edit(./**/*credential*)",
      "Edit(./**/*credentials*)",
      "Edit(./**/*token*)",
      "Edit(./**/*cert*)",
      "Edit(./.claude/settings.local.json)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -f *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd)",
      "Bash(git clean -fd *)",
      "Bash(git clean -xfd)",
      "Bash(git clean -xfd *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(chmod 777 *)",
      "Bash(chown *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shred *)",
      "Bash(truncate *)",
      "Bash(*deploy*)",
      "Bash(ssh *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma migrate deploy *)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma db seed *)",
      "Bash(npx *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(docker compose *)",
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "WebFetch"
    ]
  },
  "autoMemoryEnabled": true,
  "disableAutoMode": "disable",
  "claudeMdExcludes": [
    "**/node_modules/**/CLAUDE.md",
    "**/.next/**/CLAUDE.md",
    "**/dist/**/CLAUDE.md",
    "**/build/**/CLAUDE.md",
    "**/coverage/**/CLAUDE.md"
  ],
  "autoCompactEnabled": true,
  "defaultMode": "default",
  "disableBypassPermissionsMode": "disable",
  "enabledPlugins": {
    "drydocs@cardio": true
  }
}
